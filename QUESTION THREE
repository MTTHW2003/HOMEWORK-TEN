from graphics import *


def frequency(filename):
    infile = open(filename, "r")

    text = infile.read().lower()

    infile.close()

    counts = [0] * 26

    for ch in text:
        if ch >= "a" and ch <= "z":
            counts[ord(ch) - ord("a")] += 1

    return counts


def drawGraph(counts):
    win = GraphWin("Letter Frequency Analysis", 700, 500)

    total = sum(counts)

    if total == 0:
        print("No letters found.")
        win.close()
        return

    ratios = [count / total for count in counts]

    highest = max(ratios)

    win.setCoords(-1, 0, 27, highest * 1.2)

    for i in range(26):
        x = i

        bar = Rectangle(
            Point(x + 0.1, 0),
            Point(x + 0.9, ratios[i])
        )

        bar.setFill("blue")
        bar.draw(win)

        label = Text(Point(x + 0.5, -highest * 0.04),
                     chr(i + ord("a")))

        label.draw(win)

    win.getMouse()
    win.close()


def main():
    filename = input("Enter text filename: ")

    counts = frequency(filename)

    drawGraph(counts)


main()
